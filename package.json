{
  "name": "days-between",
  "version": "2.0.0",
  "description": "Days Between — Live music streaming desktop app, powered by Relisten",
  "author": "Days Between contributors",
  "license": "MIT",
  "main": "app/main.js",
  "scripts": {
    "start": "electron .",
    "dist":  "electron-builder --publish never",
    "test":  "node --test test/*.test.js"
  },
  "dependencies": {
    "castv2-client": "^1.2.0",
    "localforage": "^1.10.0",
    "multicast-dns": "^7.2.5"
  },
  "optionalDependencies": {
    "mpris-service": "^2.1.2"
  },
  "devDependencies": {
    "electron": "^41.2.0",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.daysbetween.desktop",
    "productName": "Days Between",
    "copyright": "© 2026 Days Between contributors. MIT licensed.",
    "files": [
      "app/**/*",
      "assets/**/*",
      "!config.js",
      "!**/*.map"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.png",
      "category": "public.app-category.music",
      "identity": null
    },
    "dmg": {
      "title": "Days Between ${version}"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icon.png",
      "category": "AudioVideo;Audio;Player",
      "synopsis": "Live concert recordings desktop app",
      "description": "Stream and archive 70,000+ live concert recordings from Relisten, Nugs.net, and Mixlr. Combines authoritative setlist.fm play counts, attended-show tracking, and personalized recommendations into a single library.",
      "maintainer": "Days Between <noreply@github.com>",
      "desktop": {
        "entry": {
          "Name": "Days Between",
          "GenericName": "Live Music Player",
          "Keywords": "music;audio;concerts;livestream;jam;phish;deadhead;nugs;relisten;"
        }
      }
    }
  }
}
